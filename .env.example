# Copy this file to .env.local and fill in the real values. Never commit .env.local.

# Neon pooled connection string (host contains "-pooler"). Used by the website.
DATABASE_URL=

# Neon direct connection string (no "-pooler"). Used only for migrations, seeding and backups.
DATABASE_URL_UNPOOLED=

# Random secret of at least 32 characters used to sign admin login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public address of the website, used for share previews (Facebook/WhatsApp). Netlify fills in
# its own URL automatically; set this once the real domain is connected, for example https://anpinpathai.org
SITE_URL=

# Cloudflare R2 (photo storage). While these are missing or start with "dummy",
# uploads are saved to public/dev-uploads on your own computer (development only).
R2_ACCOUNT_ID=dummy
R2_ACCESS_KEY_ID=dummy
R2_SECRET_ACCESS_KEY=dummy
R2_BUCKET=dummy
# Public address of the bucket, for example https://pub-xxxx.r2.dev or https://media.example.org
R2_PUBLIC_URL=dummy
